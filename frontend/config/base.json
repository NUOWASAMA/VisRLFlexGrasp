{
    "gateway": {
        "host": "127.0.0.1",
        "port": 8080,
        "ws_path": "/ws",
        "api_prefix": "/api",
        "static_dir": "frontend/dist",
        "max_frame_bytes": 1048576,
        "heartbeat_interval_sec": 3,
        "heartbeat_timeout_sec": 10,
        "reconnect_intervals_sec": [1, 3, 5],
        "send_timeout_sec": 3,
        "log_level": "INFO",
        "log_file": "logs/frontend/gateway.log"
    },
    "backend": {
        "http": {
            "host": "127.0.0.1",
            "port": 8000
        },
        "tcp": {
            "host": "127.0.0.1",
            "port": 9000
        }
    },
    "ui": {
        "poll_interval_ms": 2000,
        "default_force_limit": 5.0,
        "categories": ["apple", "pear", "tomato", "orange"],
        "speed_levels": [1, 2, 3],
        "event_log_limit": 200,
        "task_history_limit": 20
    }
}
